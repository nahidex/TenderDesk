# server.py কনফিগারেশন ফাইল
# এই ফাইলটার নাম "server.py"-র পাশে ".env" (ডট দিয়ে শুরু, .example বাদ) রাখুন।
# যেকোনো লাইন লাগবে না-লাগলে # দিয়ে কমেন্ট আউট করে রাখুন বা লাইনটা মুছে দিন।

# কোন পোর্টে সার্ভার চলবে (ডিফল্ট 5000)
PORT=8080

# কোন নেটওয়ার্ক ইন্টারফেসে শোনা হবে — 0.0.0.0 মানে সব ইন্টারফেস (LAN থেকেও অ্যাক্সেসযোগ্য)
HOST=0.0.0.0

# কোন ফোল্ডারটা ব্রাউজ করা যাবে (ডিফল্ট: server.py যেই ফোল্ডারে আছে)
# BROWSE_ROOT=/path/to/your/folder
